import std.fs.file (ReadOnlyFile)
import std.fs.path (Path)
import std.json (Json)

type Config {
  let @mapping: Map[String, String]

  fn static load(path: Path) -> Result[Config, String] {
    let conf = Config.new
    let file = try ReadOnlyFile.new(path).map_error(fn (e) { e.to_string })
    let map = match Json.parse(file).map_error(fn (e) { e.to_string }) {
      case Ok(Object(v)) -> v
      case Ok(_) -> throw 'the configuration must be a JSON object'
      case Error(e) -> throw e.to_string
    }

    for (key, val) in map {
      let String(val) = val else throw 'the value of each key must be a string'

      conf.mapping.set(key, val)
    }

    Result.Ok(conf)
  }

  fn static default(directory: ref Path) -> Result[Config, String] {
    let path = directory.join('config.json')

    if path.file? { Config.load(path) } else { Result.Ok(Config.new) }
  }

  fn static new -> Config {
    Config(mapping: Map.new)
  }
}
