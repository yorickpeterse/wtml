import std.env (arguments, working_directory)
import std.optparse (Help, Options)
import std.stdio (Stderr, Stdout)
import std.sys (exit)
import wtml.config (Config)
import wtml.csv (parse)

fn show_help(options: ref Options, output: mut Stdout) {
  let help = Help
    .new('wtml [CSV FILE]')
    .description(
      'Provides an overview of monthly costs based on an ING CSV file.',
    )
    .section('Options')
    .options(options)
    .into_string

  let _ = output.write(help)
}

fn run -> Result[Nil, String] {
  let out = Stdout.new
  let opts = Options.new
  let pwd = working_directory.or_else(fn (_) { '.'.to_path })

  opts.flag('h', 'help', 'Show this help message')
  opts.single('c', 'config', 'PATH', 'The configuration file to use')

  let matches = try opts.parse(arguments).map_error(fn (e) { e.to_string })

  if matches.contains?('help') or matches.remaining.empty? {
    show_help(opts, out)
    return Result.Ok(nil)
  }

  let path = match matches.remaining.get(0) {
    case Ok(v) -> v.to_path
    case _ -> {
      show_help(opts, out)
      return Result.Ok(nil)
    }
  }

  let conf = try matches
    .value('config')
    .map(fn (p) { Config.load(p.to_path) })
    .or_else(fn { Config.default(pwd) })
    .map_error(fn (e) { 'failed to load the configuration: ${e}' })

  let pairs = try parse(path, conf).map_error(fn (e) { e.to_string })

  for (name, val) in pairs {
    out.print('${name}\t${val.round(2).to_string.replace('.', ',')}')
  }

  Result.Ok(nil)
}

type async Main {
  fn async main {
    match run {
      case Ok(_) -> {}
      case Error(e) -> {
        let _ = Stderr.new.print('\e[31;1merror\e[0m: ${e}')

        exit(1)
      }
    }
  }
}
